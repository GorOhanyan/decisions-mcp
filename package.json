{
  "name": "decisions-mcp",
  "version": "0.4.0",
  "description": "MCP server that lets any AI coding agent scan huge codebases with OpenRouter decision models (Jev, Clef, Mercury Decide, \u2026) \u2014 locate bugs from symptoms, classify and filter files \u2014 without burning its own context",
  "type": "module",
  "bin": {
    "decisions-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/smoke.mjs",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ignore": "^7.0.12",
    "tinyglobby": "^0.2.15",
    "zod": "^4.6.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "jev",
    "classification",
    "code-search",
    "bug-localization",
    "claude-code",
    "cursor",
    "codex",
    "ai-agent",
    "decision-models",
    "clef",
    "cloudflare"
  ],
  "author": "Gor Ohanyan (https://github.com/GorOhanyan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GorOhanyan/decisions-mcp.git"
  },
  "homepage": "https://github.com/GorOhanyan/decisions-mcp#readme",
  "bugs": {
    "url": "https://github.com/GorOhanyan/decisions-mcp/issues"
  }
}
